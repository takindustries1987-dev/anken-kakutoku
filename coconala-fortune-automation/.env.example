# Claude API (鑑定文生成に使用)
ANTHROPIC_API_KEY=

# ココナラ ログイン情報 (coconala_client.py の実装完了後に使用)
COCONALA_EMAIL=
COCONALA_PASSWORD=

# 評価がこの星数(1〜5)以上ならポートフォリオ掲載対象にする
GOOD_REVIEW_MIN_STARS=4

# true にすると、顧客への返信・納品・評価依頼・評価返信を人の確認なしで自動送信する
# false の間はログ出力のみ(ドライラン)。coconala_client.py の実装とテストが終わるまでは false 推奨
AUTO_SEND=false

# 鑑定文生成に使う Claude モデル
FORTUNE_MODEL=claude-opus-5
